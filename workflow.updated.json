    {
      "parameters": {
        "jsCode": "const today = new Date();\nconst yyyy = today.getFullYear();\nconst mm = String(today.getMonth() + 1).padStart(2, '0');\nconst dd = String(today.getDate()).padStart(2, '0');\nconst dateFolder = `${yyyy}-${mm}-${dd}`;\n\nreturn [{\n  json: {\n    moduleName: 'Sundry Payment Vouchers',\n    basePath: 'C:\\\\laragon\\\\www\\\\ramco-scraper2\\\\output\\\\Sundry Payment Vouchers',\n    dateFolder,\n    driveRootFolderId: '1a0U8GkkNpVNm0zZ683Jzj3SNvY2B3EQp'\n  }\n}];\n"
      },
      "id": "b1cd16a1-0d06-4e51-976c-270dbd9e6e16",
      "name": "Build Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2144,
        144
