    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst sd = $getWorkflowStaticData('global');\nsd.folderMap = {};\nsd.filesThisRun = items.map(i => i.json);\n\nconst driveRootFolderId = items[0].json.driveRootFolderId;\nconst paths = new Set();\nfor (const it of items) {\n  const segs = it.json.relativeFolderSegments || [];\n  for (let i = 1; i <= segs.length; i++) paths.add(segs.slice(0, i).join('/'));\n}\nconst sorted = [...paths].sort((a, b) => a.split('/').length - b.split('/').length);\n\nreturn sorted.map(relPath => {\n  const segs = relPath.split('/');\n  return {\n    json: {\n      relativeFolderPath: relPath,\n      folderName: segs[segs.length - 1],\n      parentRelativeFolderPath: segs.slice(0, -1).join('/'),\n      driveRootFolderId\n    }\n  };\n});\n"
      },
