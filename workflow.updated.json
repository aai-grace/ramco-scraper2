    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst path = require('path');\n\nconst { basePath, driveRootFolderId, moduleName } = $input.first().json;\n\nif (!fs.existsSync(basePath)) {\n  return [{ json: { filePath: '', driveRootFolderId } }];\n}\n\nfunction walk(dir, out = []) {\n  for (const entry of fs.readdirSync(dir)) {\n    const full = path.join(dir, entry);\n    if (fs.statSync(full).isDirectory()) walk(full, out);\n    else out.push(full);\n  }\n  return out;\n}\n\nconst matching = walk(basePath);\n\nif (matching.length === 0) {\n  return [{ json: { filePath: '', driveRootFolderId } }];\n}\n\nreturn matching.map(filePath => {\n  const rel = filePath.substring(basePath.length).replace(/^[\\\\/]+/, '');\n  const parts = rel.split(path.sep);\n  const fileName = parts.pop();\n  const segments = [moduleName, ...parts];\n  return {\n    json: {\n      filePath,\n      fileName,\n      relativeFolderSegments: segments,\n      relativeFolderPath: segments.join('/'),\n      driveRootFolderId\n    }\n  };\n});\n"
      },
