    {
      "parameters": {
        "jsCode": "const today = new Date();\nconst yyyy = today.getFullYear();\nconst mm = String(today.getMonth() + 1).padStart(2, '0');\nconst dd = String(today.getDate()).padStart(2, '0');\nconst dateFolder = `${yyyy}-${mm}-${dd}`;\n\nconst driveRootFolderId = '1a0U8GkkNpVNm0zZ683Jzj3SNvY2B3EQp';\nconst baseDir = 'C:\\\\laragon\\\\www\\\\ramco-scraper2\\\\output';\n\nconst modules = [\n  'Sundry Payment Vouchers',\n  'Supplier Debit Credit Notes',\n  'Supplier Order Based Invoices',\n  'Supplier Prepayment Invoices',\n  'Supplier Payment Vouchers (CDV)',\n  'Journal Vouchers',\n  'Purchase Requests',\n  'Purchase Orders',\n  'Goods Receipts',\n  'Customer Receipts',\n  'Customer Debit Credit Notes',\n  'Sundry Receipts'\n];\n\nreturn modules.map(moduleName => ({\n  json: {\n    moduleName,\n    basePath: `${baseDir}\\\\${moduleName}`,\n    dateFolder,\n    driveRootFolderId\n  }\n}));\n"
      },
      "id": "5aedd57f-acdb-40a4-b13a-674e6ae78313",
      "name": "Build Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1056,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst path = require('path');\n\nfunction walk(dir, out = []) {\n  for (const entry of fs.readdirSync(dir)) {\n    const full = path.join(dir, entry);\n    if (fs.statSync(full).isDirectory()) walk(full, out);\n    else out.push(full);\n  }\n  return out;\n}\n\nconst results = [];\nlet driveRootFolderId = '';\n\nfor (const item of $input.all()) {\n  const { basePath, moduleName } = item.json;\n  driveRootFolderId = item.json.driveRootFolderId;\n\n  if (!fs.existsSync(basePath)) continue;\n\n  for (const filePath of walk(basePath)) {\n    const rel = filePath.substring(basePath.length).replace(/^[\\\\/]+/, '');\n    const parts = rel.split(path.sep);\n    const fileName = parts.pop();\n    const segments = [moduleName, ...parts];\n    results.push({\n      json: {\n        filePath,\n        fileName,\n        moduleName,\n        relativeFolderSegments: segments,\n        relativeFolderPath: segments.join('/'),\n        driveRootFolderId\n      }\n    });\n  }\n}\n\nif (results.length === 0) {\n  return [{ json: { filePath: '', driveRootFolderId } }];\n}\n\nreturn results;"
      },
